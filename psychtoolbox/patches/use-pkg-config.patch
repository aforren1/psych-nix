@@ -294,6 +296,17 @@
 return;
 end
 
+% Ask pkg-config for include flags instead of hardcoding FHS and multiarch
+% paths, so the build works outside of Debian/Ubuntu.
+function flags = pkgconfig_iflags(pkgs)
+  [rc, out] = system(['pkg-config --cflags-only-I ' pkgs]);
+  if rc ~= 0
+    error('pkg-config failed for: %s', pkgs);
+  end
+  flags = strsplit(strtrim(out));
+  flags = flags(~cellfun('isempty', flags));
+end
+
 % Our own override implementation of mex(), shadowing
 % octave's mex.m . This one uses glob() to glob-expand all
 % *.c shell patterns to corresponding lists of source
